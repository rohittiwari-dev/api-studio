{
  "name": "api-studio",
  "version": "1.2.0",
  "private": true,
  "description": "A modern, feature-rich API client and testing studio for developers. Build, test, and debug APIs with an intuitive interface.",
  "keywords": [
    "api",
    "api-client",
    "api-testing",
    "rest-api",
    "http-client",
    "developer-tools",
    "postman-alternative",
    "api-studio",
    "web-development"
  ],
  "homepage": "https://github.com/rohittiwari-dev/api-client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rohittiwari-dev/api-client.git"
  },
  "bugs": {
    "url": "https://github.com/rohittiwari-dev/api-client/issues"
  },
  "author": {
    "name": "Rohit Tiwari",
    "url": "https://github.com/rohittiwari-dev"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "lint": "biome check",
    "format": "biome format --write",
    "prepare": "husky",
    "typecheck": "tsc"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,cjs,mjs,json,md,css,scss,html,yml,yaml}": [
      "biome format"
    ],
    "**/*.{ts,tsx,js,jsx,cjs,mjs}": [
      "biome check"
    ]
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
